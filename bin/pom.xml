<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>vn.edu.ktpm</groupId>
    <artifactId>minishop-automation</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>
    <name>MiniShop Automation Seminar (ban rut gon v2)</name>

    <!--
        ============================================================================
        MOT PROJECT - MOT POM - MOT LENH CHAY
        ============================================================================
        src/main/java  : ma nguon nghiep vu cua MiniShop (doi tuong duoc kiem thu)
        src/test/java  : 4 tang test
              unit/    JUnit 5 + EasyMock  (chay bang JUnit Platform)
              web/     TestNG + Selenium   (chay bang testng-engine tren JUnit Platform)
              pw/      JUnit 5 + Playwright
              mobile/  JUnit 5 + Appium    (mac dinh BO QUA, xem ghi chu ben duoi)

        Cach chay:
            mvn clean test                       -> unit + web + playwright
            mvn clean test -Dheadless=false      -> hien trinh duyet de quay video
            mvn clean test -Dmobile.tests=true   -> chay them tang Appium (can Emulator)
            mvn test jacoco:report               -> bao cao do phu ma lenh
        ============================================================================
    -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <junit.version>5.11.4</junit.version>
        <testng.version>7.10.2</testng.version>
        <testng.engine.version>1.0.5</testng.engine.version>
        <easymock.version>5.4.0</easymock.version>
        <selenium.version>4.21.0</selenium.version>
        <playwright.version>1.44.0</playwright.version>
        <appium.version>9.2.2</appium.version>
        <allure.version>2.27.0</allure.version>
        <aspectj.version>1.9.22</aspectj.version>

        <!-- Tham so chay, ghi de tu dong lenh bang -Dten=gia-tri -->
        <headless>true</headless>
        <pw.channel>chrome</pw.channel>
        <mobile.tests>false</mobile.tests>
        <appium.server.url>http://127.0.0.1:4723</appium.server.url>
        <android.device>Android Emulator</android.device>
    </properties>

    <!--
        BAT BUOC: junit-bom dong bo phien ban cho MOI thu vien ho junit-platform.
        Neu bo khoi day, Maven se lay junit-platform-engine 1.7.2 (theo testng-engine) va
        junit-platform-launcher 1.9.2 (theo allure-junit5) => engine JUnit Jupiter chet ngay khi
        khoi dong (NoClassDefFoundError NamespacedHierarchicalStore), TestNG van chay nen build
        "trong nhu binh thuong" nhung THIEU HAN tang unit test. Da gap that khi gop project.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ===== Tang unit: JUnit 5 + EasyMock ===== -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.easymock</groupId>
            <artifactId>easymock</artifactId>
            <version>${easymock.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ===== Tang UI: TestNG + Selenium =====
             testng-engine giup TestNG chay chung mot lan voi JUnit 5 tren JUnit Platform.
             Neu thieu no, Surefire chi chon MOT provider va se BO QUA am tham mot tang test. -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.support</groupId>
            <artifactId>testng-engine</artifactId>
            <version>${testng.engine.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ===== Tang UI doi chung: Playwright ===== -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ===== Tang mobile: Appium ===== -->
        <dependency>
            <groupId>io.appium</groupId>
            <artifactId>java-client</artifactId>
            <version>${appium.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ===== Bao cao: Allure ===== -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <version>${aspectj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- @{argLine} giu lai agent cua JaCoCo, sau do gan them agent cua Allure -->
                    <argLine>
                        @{argLine}
                        -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
                    </argLine>
                    <systemPropertyVariables>
                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                        <headless>${headless}</headless>
                        <pw.channel>${pw.channel}</pw.channel>
                        <mobile.tests>${mobile.tests}</mobile.tests>
                        <appium.server.url>${appium.server.url}</appium.server.url>
                        <android.device>${android.device}</android.device>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <configuration>
                    <!-- LocalWebServer la tien ich phuc vu test, khong phai doi tuong kiem thu -->
                    <excludes>
                        <exclude>vn/edu/ktpm/minishop/support/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
